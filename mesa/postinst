#!/bin/sh
set -e

MALI_CONF=/etc/ld.so.conf.d/00-aarch64-mali.conf
MALI_DIVERT=/etc/ld.so.conf.d/00-aarch64-mali.conf.disabled-by-mesa25-ans

# Keep the BSP libmali package installed for dependency compatibility, but do
# not let its G52 EGL/GLES/GBM loader override GLVND and Mesa on RK3588/G610.
divert_package=$(dpkg-divert --listpackage "$MALI_CONF" 2>/dev/null || true)
if [ -z "$divert_package" ]; then
    dpkg-divert --package mesa25-ans --add --rename \
        --divert "$MALI_DIVERT" "$MALI_CONF"
elif [ "$divert_package" != mesa25-ans ]; then
    echo "mesa25-ans: $MALI_CONF is already diverted by $divert_package" >&2
    exit 1
fi

ldconfig 2>/dev/null || true

if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
